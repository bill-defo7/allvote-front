# Copiez ce fichier en .env puis adaptez.

# URL de l'API Spring Boot AllVote (avec /api à la fin)
VITE_API_URL=http://localhost:8081/api

# URL publique du site (balises SEO / partage)
VITE_SITE_URL=https://allvote.cm

# Contact affiché sur le site (laisser vide pour masquer)
VITE_CONTACT_TEL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_WHATSAPP=

# Google Analytics 4 (laisser vide pour désactiver). Chargé uniquement après consentement cookies.
VITE_GA_ID=
